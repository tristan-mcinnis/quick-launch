#!/bin/bash
# The unchanged global pre-push discovers this through .test-command.
# Keep the full Swift gate, but do not leak this repo into dependency clones.
set -euo pipefail
git_environment="$(git rev-parse --local-env-vars)"
for variable in $git_environment; do unset "$variable"; done
cd "$(git rev-parse --show-toplevel)"
# pre-push leaves a one-shot marker naming HEAD when the main push changes
# docs only (its scrub has already run). Any other state runs the full suite.
marker="$(git rev-parse --absolute-git-dir)/ql-docs-only-push"
if [[ -f "$marker" ]] && [[ "$(cat "$marker")" == "$(git rev-parse HEAD)" ]]; then
  rm -f "$marker"
  echo "test-command: docs-only push of $(git rev-parse --short HEAD); swift test skipped."
  exit 0
fi
rm -f "$marker"
exec swift test
